# ============================================================
# environmental-monitoring 环境变量示例（复制为 .env 并按环境填写）
# 说明：后端 Spring Boot 通过 application.properties 读取；
#       数据库密码建议以环境变量注入，避免明文入库。
# ============================================================

# MySQL 连接
DB_PASSWORD=your_mysql_password

# 后端可选参数
SERVER_PORT=8080

# 模拟数据源（演示环境建议 true，真实硬件接入时 false）
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
